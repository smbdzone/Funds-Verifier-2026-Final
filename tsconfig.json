{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/page.jsx",
    "src/app/layout.js",
    "src/app/(Property)/layout.js",
    "src/components/modules/Car/Car-sidebar-filter.jsx",
    "src/components/global/layout.jsx",
    "src/app/api/country/route.js",
    "src/app/(BuyerProfileLayout)/evaluator-profile/property-evaluation/page.jsx",
    "src/app/coming-soon/page.jsx",
    "src/app/coming-soon/layout.jsx",
    "src/components/modules/ListingSidebar.jsx",
    "src/components/modules/SellerProfile/SellerLayout.jsx",
    "src/app/(BuyerProfileLayout)/seller-profile/my-profile/page.jsx",
    "src/app/(BuyerProfileLayout)/seller-profile/my-profile/change-password/page.jsx",
    "src/app/(BuyerProfileLayout)/evaluator-profile1/asset-evaluation/page.jsx",
    "src/app/(BuyerProfileLayout)/seller-profile/asset-evaluation/page.jsx",
    "src/app/(EvaluatorProfileLayout)/evaluator-profile/asset-evaluation/page.jsx",
    "src/components/ErrorBoundary/ErrorBoundary.js",
    "src/app/api/stripe-checkout/route.js",
    "src/components/modules/AuctionData.jsx",
    "src/app/(HomeLayout)/technical-report-success/page.jsx",
    "src/app/(TrsuteeDashboard)/Trustee/viewing/page.jsx",
    "src/app/(TrsuteeDashboard)/Trustee/asset-overview/page.jsx",
    "src/components/Layout/Header.jsx",
    "src/components/Modals/ModalLayout.jsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.d.ts",
    "**/*.d.ts.map",
    ".next",
    "dist"
  ]
}
